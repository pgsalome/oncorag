{
  "cohort": {
    "name": "example_cohort",
    "language": "en",
    "evaluation_role": "custom deployment",
    "ground_truth_source": "not configured",
    "pipeline_status": "configured for this cohort",
    "feature_configuration": "automatic"
  },
  "inputs": {
    "notes_root": "../clinical_notes",
    "registry_path": null,
    "patient_ids_file": null,
    "note_layout": "patient_id/report_type/YYYY-MM-DD.txt",
    "date_source": "path"
  },
  "features": {
    "specifications": "../examples/features.synthetic.yaml",
    "generated_config_dir": "../generated/feature_configs",
    "generate_if_missing": true,
    "language": "english",
    "configuration_mode": "automatic",
    "ontology_enrichment": {
      "sources": ["UMLS", "BioPortal", "WordNet"],
      "max_concepts_per_feature": 5,
      "minimum_relevance_score": 0.6
    }
  },
  "runtime": {
    "local_processing_only": true,
    "random_seed": 2025,
    "workers": 1,
    "ollama": {
      "host": "http://127.0.0.1:11434",
      "model": "phi3:medium",
      "quantization": "provider-managed",
      "temperature": 0,
      "num_ctx": 4096,
      "timeout_seconds": 120
    },
    "hardware": {
      "minimum_vram_gb": 24,
      "cpu_fallback_supported": true
    }
  },
  "vector_store": {
    "backend": "chroma",
    "collection_namespace": "example_cohort",
    "iris": {
      "host": "127.0.0.1",
      "port": 1972,
      "namespace": "USER",
      "username": null,
      "password_env": "IRIS_PASSWORD",
      "table": "SQLUser.OncoRAGVectors",
      "vector_dimension": 768,
      "timeout_seconds": 30,
      "initialize_schema": true
    }
  },
  "retrieval": {
    "top_k": 5,
    "candidate_entity_limit": 30,
    "weights": {
      "semantic_weight": 1.0,
      "lexical_weight": 0.25,
      "name_weight": 0.3,
      "graph_weight": 0.3,
      "boost_alpha": 0.4,
      "penalty_beta": 0.4
    },
    "graph_diffusion": {
      "enabled": true,
      "similarity_threshold": 0.55,
      "max_neighbors": 12,
      "iterations": 2,
      "residual_alpha": 0.6
    },
    "weight_selection": {
      "method": "grid search",
      "range": [0.0, 1.0],
      "step": 0.05,
      "objective": "macro_f1",
      "status": "lock before held-out evaluation"
    }
  },
  "chat": {
    "history_turns": 5,
    "max_question_chars": 4000,
    "max_history_chars": 12000,
    "feature_match_threshold": 0.45
  },
  "temporal_anchoring": {
    "baseline": {
      "reference": "initial_cancer_diagnosis",
      "window_months": 9,
      "selection": "closest_documented_value"
    },
    "outcome": {
      "selection": "last_documented_value"
    },
    "mimic": {
      "selection": "first_reported_value"
    }
  },
  "evaluation": {
    "bootstrap": {
      "resamples": 1000,
      "confidence_level": 0.95,
      "unit": "per_feature_f1"
    },
    "feature_complexity_stratification": true,
    "confidence_calibration": {
      "labels": ["High", "Medium", "Low"],
      "bootstrap_confidence_intervals": true,
      "association_test": "chi_square_with_cramers_v"
    },
    "rare_class_sensitivity": {
      "max_minority_count": 5,
      "max_prevalence": 0.1
    },
    "top_k_ablation": {
      "values": [3, 5, 10],
      "keep_all_other_parameters_fixed": true
    },
    "retrieval_weight_sensitivity": {
      "relative_perturbations": [0.5, 1.5],
      "one_at_a_time": true,
      "stability_metric": "jaccard_top_k_sentences"
    },
    "inter_rater_agreement": {
      "metric": "cohen_kappa",
      "bootstrap_confidence_intervals": true
    },
    "model_comparison": {
      "models": ["phi3:medium", "phi3:mini"],
      "context_windows": [4096, 131072],
      "baselines": ["direct_llm", "naive_vector_rag", "raw_semantic_retrieval"]
    }
  },
  "outputs": {
    "root": "../outputs/example_run",
    "graph_cache_dir": "graphs",
    "chroma_cache_dir": "chroma",
    "prompt_cache_dir": "prompt_cache",
    "results_file": "structured_features.json"
  }
}
